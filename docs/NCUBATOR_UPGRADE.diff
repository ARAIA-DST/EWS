 export function dashboardView(d,ctx){return heading('Dashboard','Pantau risiko dan tindak lanjut tim NC.',button('Laporan bulanan','go', 'data-route="reports"','')+(edit(ctx)?formButton('signal','Input sinyal'):''),'RETENTION WORKSPACE')+`<div class="flow-strip">${[['DETECT','Tangkap sinyal'],['TALK','Mulai percakapan'],['UNDERSTAND','Cari akar masalah'],['ACT','Action plan 30 hari'],['FOLLOW UP','Check-in terjadwal'],['MEASURE','Lihat perubahan']].map(([l,s],i)=>`<div class="flow-step"><i>${i+1}</i><div><b>${l}</b><span>${s}</span></div></div>`).join('')}</div>`+kpis(d)+`<div class="secondary-stats"><span><b>${d.onboarding}</b> NC dalam onboarding</span><span><b>${d.pending}</b> izin/cuti menunggu approval</span><span><b>${d.plansDue}</b> action plan jatuh tempo</span><span><b>${d.signalCoverage}/${d.total}</b> NC memiliki input sinyal</span></div><div class="grid2"><section class="panel"><div class="panel-header"><h2>Tren risk score</h2><span class="muted">Rata-rata · 12 minggu</span></div><div class="panel-body">${lineChart(d.trend)}</div></section><section class="panel"><div class="panel-header"><h2>Distribusi risiko per area</h2><span class="muted">NC aktif</span></div><div class="panel-body">${areaChart(d.areas)}${legend()}</div></section></div><section class="panel"><div class="panel-header"><h2>Perlu tindakan hari ini</h2><a href="#/early-warning">Lihat semua</a></div>${riskTable(d.actions,{},true)}</section><section class="panel"><div class="panel-header"><h2>Tindak lanjut jatuh tempo</h2><a href="#/reminders">Lihat semua</a></div>${d.reminders.length?d.reminders.slice(0,4).map(r=>`<div class="reminder-row"><div><b>${esc(r.title)}</b><p><a href="#/nc/${encodeURIComponent(r.nc_id)}/summary">${esc(r.nama)}</a> · ${fmtDate(r.due)}</p></div><span class="small muted">${r.overdue} hari lewat</span></div>`).join(''):empty('Tidak ada tindak lanjut yang jatuh tempo.')}</section>`;}
