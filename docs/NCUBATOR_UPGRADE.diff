 export function planCard(p,ctx){return`<section class="plan-card"><header><div><h3><a href="#/nc/${encodeURIComponent(p.nc_id)}/plans">${esc(p.nama)}</a></h3><span class="small muted">${fmtDate(p.mulai)}–${fmtDate(p.end)} · ${esc(p.status)}</span></div><span class="chip neutral">${p.completion}% tindakan selesai</span></header><div class="secondary-stats"><span>Skor awal <b>${p.initial_score}</b></span><span>Saat ini <b>${p.current_score}</b></span><span>Target <b>${p.target_score}</b></span>${p.hasil_akhir?`<span>Hasil <b>${esc(p.hasil_akhir)}</b></span>`:''}</div>${p.akar_masalah?`<p class="muted small">Akar masalah: ${esc(p.akar_masalah)}</p>`:''}${p.items.map(i=>`<label class="plan-item"><input type="checkbox" data-action="item" data-id="${esc(i.item_id)}" ${i.selesai?'checked':''} ${!edit(ctx)||p.status!=='Aktif'?'disabled':''}><span>${esc(i.tindakan)}<small>${esc(i.pic)} · ${fmtDate(i.due_date)}</small></span></label>`).join('')}<div class="checkin-grid">${p.schedule.map(s=>`<div class="checkin-box"><b>Hari ${s.day}</b><span>${fmtDate(s.due)}</span><p class="muted">${esc(s.check?.status||'Belum check-in')}</p>${s.check?.catatan?`<p class="small">${esc(s.check.catatan)}</p>`:''}${edit(ctx)&&p.status==='Aktif'?formButton('checkin',s.check?'Perbarui':'Check-in',`data-plan="${esc(p.plan_id)}" data-day="${s.day}"`,'small'):''}</div>`).join('')}</div>${edit(ctx)&&p.status==='Aktif'?formButton('closePlan','Ukur & tutup plan',`data-plan="${esc(p.plan_id)}"`,'text'):''}</section>`;}
 export function plansView(d,ctx,p){return heading('Action Plan 30 Hari','Sepakati tindakan, check-in, dan ukur perubahan risiko.',edit(ctx)?formButton('plan','Buat action plan'):'','04–06 / ACT, FOLLOW UP & MEASURE')+`<div class="toolbar">${sel('status','Semua status',['Aktif','Selesai'],p)}${button('Unduh CSV','csv','','')}<span class="filter-count">${d.total} action plan</span></div>`+(d.rows.length?d.rows.map(r=>planCard(r,ctx)).join(''):empty('Belum ada action plan.'))+pager(d);}
 export function signalsView(ctx){return heading('Input Sinyal','Severity 0: tidak ada · 1: ringan · 2: sedang · 3: berat.',edit(ctx)?formButton('signal','Input per NC'):'','01 / DETECT')+`<section class="panel"><div class="panel-header"><h2>Import dari spreadsheet</h2></div><div class="panel-body"><p class="muted">Salin kolom dengan header berikut. Maksimal 200 baris per batch; seluruh batch divalidasi sebelum disimpan.</p><div class="notice" style="margin:14px 0;overflow:auto"><code>nc_id&nbsp; periode&nbsp; attendance&nbsp; commitment&nbsp; performance&nbsp; execution&nbsp; engagement&nbsp; support&nbsp; catatan</code></div><div class="field"><label for="import-text">Tempel tabel (tab/TSV)</label><textarea id="import-text" rows="9" placeholder="nc_id&#9;periode&#9;attendance&#9;commitment&#9;performance&#9;execution&#9;engagement&#9;support&#9;catatan" ${!edit(ctx)?'disabled':''}></textarea></div><div class="btn-row">${edit(ctx)?button('Lihat preview','import-preview','','')+button('Simpan batch','import-save','disabled','primary'):''}<span id="import-status" class="muted small"></span></div><div id="import-preview" class="import-preview"></div></div></section>`;}
 export function attritionView(d,ctx,p){return heading('Attrition Log','Riwayat resign dan hasil deteksi sebelum pengunduran diri.',['Admin','HR'].includes(ctx.user.role)?formButton('attrition','Catat resign'):'')+`<div class="toolbar"><input type="month" data-filter="month" value="${esc(d.period)}" aria-label="Periode attrition">${button('Unduh CSV','csv','','')}<span class="muted small">Rate = resign bulan ini ÷ rata-rata headcount awal/akhir bulan.</span></div><div class="kpi-grid">${[['Attrition rate',d.rate+'%'],['Resign bulan ini',d.resigns],['Rata-rata masa kerja',d.avgTenure+' hari'],['Sudah terdeteksi',d.detected+'%']].map(([l,v])=>`<div class="kpi"><div class="kpi-label">${l}</div><strong>${v}</strong></div>`).join('')}</div><section class="panel"><div class="panel-header"><h2>Alasan resign · ${esc(d.period)}</h2></div><div class="panel-body">${d.reasons.filter(r=>r.count).map(r=>`<div class="reason-bar"><span>${esc(r.reason)}</span><div class="progress"><i style="width:${r.count/Math.max(1,d.resigns)*100}%"></i></div><b>${r.count}</b></div>`).join('')||empty('Tidak ada resign pada periode ini.')}</div></section>${d.rows.rows.length?`<div class="table-wrap"><table class="data-table"><thead><tr><th>NC</th><th>Efektif resign</th><th>Alasan utama</th><th>Masa kerja</th><th>High Risk sebelum resign</th><th>Action plan</th></tr></thead><tbody>${d.rows.rows.map(r=>`<tr><td>${ncLink(r)}</td><td>${fmtDate(r.tgl_efektif)}</td><td>${esc(r.alasan)}</td><td>${r.masa_kerja_hari} hari</td><td>${r.pernah_high_risk===true||r.pernah_high_risk==='true'?'Ya':'Tidak'}</td><td>${r.pernah_action_plan===true||r.pernah_action_plan==='true'?'Pernah':'Tidak'}</td></tr>`).join('')}</tbody></table></div>`:empty('Belum ada riwayat resign.')}<p class="small muted" style="margin-top:12px">Tabel menampilkan seluruh riwayat; KPI mengikuti bulan yang dipilih. Deteksi sebelum resign mengukur recall, bukan akurasi total.</p>${pager(d.rows)}`;}
 export function retentionView(d,ctx,p){return heading('Papan Retensi','Ukur kualitas tindak lanjut supervisor dan area.')+`<div class="toolbar"><select data-filter="period" aria-label="Periode retensi">${[['30','30 hari'],['60','60 hari'],['90','90 hari'],['year','Tahun berjalan']].map(([v,l])=>`<option value="${v}" ${(p.period||'90')===v?'selected':''}>${l}</option>`).join('')}</select><select data-filter="group" aria-label="Kelompok peringkat"><option value="supervisor" ${p.group!=='area'?'selected':''}>Supervisor</option><option value="area" ${p.group==='area'?'selected':''}>Area</option></select>${button('Unduh CSV','csv','','')}</div><div class="table-wrap"><table class="data-table"><thead><tr><th>Peringkat</th><th>Tim</th><th>NC aktif</th><th>Retention 90 hari</th><th>Plan tepat waktu</th><th>High Risk → TALK</th><th>Check-in tepat waktu</th><th>Skor tim</th></tr></thead><tbody>${d.rows.map((r,i)=>`<tr><td>${i+1}</td><td><b>${esc(r.label)}</b></td><td>${r.total}</td><td>${r.retention}%<span class="sub">${r.sample.retention} NC</span></td><td>${r.completion??'—'}${r.completion!==null?'%':''}<span class="sub">${r.sample.plans} plan jatuh tempo</span></td><td>${r.response??'—'}${r.response!==null?' hari':''}<span class="sub">${r.sample.responses} percakapan</span></td><td>${r.checkins??'—'}${r.checkins!==null?'%':''}<span class="sub">${r.sample.checkins} jadwal</span></td><td><b>${r.quality}</b></td></tr>`).join('')}</tbody></table></div><div class="notice" style="margin-top:18px">Retention tetap memakai jendela 90 hari. Metrik tindak lanjut memakai periode filter. Skor tim: 40% retention, 30% plan tepat waktu, 20% check-in tepat waktu, 10% kecepatan respons. Sampel kosong ditampilkan “—”.</div>`;}
