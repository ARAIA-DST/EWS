@@ -0,0 +1,59 @@
+/**
+ * Pemulihan password Admin ARAIA melalui editor Apps Script.
+ * Tambahkan sebagai file baru pada proyek backend yang sudah digunakan.
+ * Isi RESET_ADMIN_USERNAME dan RESET_ADMIN_PASSWORD di Script properties,
+ * lalu jalankan resetAdminPassword dari editor. Jangan taruh password di kode.
+ * Fungsi ini tidak ditambahkan ke endpoint Web App.
+ */
+function resetAdminPassword() {
+  const lock = LockService.getScriptLock();
+  lock.waitLock(10000);
+  try {
+    const props = PropertiesService.getScriptProperties();
+    const username = String(props.getProperty('RESET_ADMIN_USERNAME') || '').trim().toLowerCase();
+    const password = props.getProperty('RESET_ADMIN_PASSWORD');
+
+    if (!/^[a-z0-9._-]{3,60}$/.test(username)) {
+      throw new Error('Isi RESET_ADMIN_USERNAME dengan username Admin yang ada di sheet Users.');
+    }
+    if (!password || password.length < 8 || password.length > 200) {
+      throw new Error('Isi RESET_ADMIN_PASSWORD di Script properties, antara 8 dan 200 karakter.');
+    }
+    if (!props.getProperty('AUTH_PEPPER')) {
+      throw new Error('AUTH_PEPPER belum tersedia. Gunakan proyek backend asli yang sudah di-setup.');
+    }
+
+    const store = store_();
+    const matches = store.read('Users').filter(user => user.username === username);
+    if (matches.length !== 1) {
+      throw new Error(matches.length ? 'Username ditemukan lebih dari sekali. Periksa sheet Users.' : 'Username tidak ditemukan. Periksa kolom username di sheet Users.');
+    }
+    const admin = matches[0];
+    if (!admin.user_id || admin.role !== 'Admin' || !RetentionCore.TRUE(admin.aktif)) {
+      throw new Error('Akun yang dipilih harus merupakan Admin aktif.');
+    }
+
+    const salt = Utilities.getUuid();
+    store.upsert('Users', {
+      ...admin,
+      salt,
+      pin_hash: passwordHash_(password, salt)
+    });
+    store.append('Audit_Log', [{
+      waktu: new Date().toISOString(),
+      user: admin.user_id,
+      aksi: 'admin.password.reset',
+      entitas: 'Users',
+      id: admin.user_id,
+      ringkasan: 'Password Admin direset melalui editor Apps Script.'
+    }]);
+    invalidate_(store.commit());
+    CacheService.getScriptCache().remove('login:' + digest_(username));
+    props.deleteProperty('RESET_ADMIN_PASSWORD');
+    props.deleteProperty('RESET_ADMIN_USERNAME');
+    console.log('Password Admin berhasil direset. Username: ' + username + '. Masuk melalui tombol Masuk menggunakan password baru Anda.');
+    return { username, role: admin.role };
+  } finally {
+    lock.releaseLock();
+  }
+}
