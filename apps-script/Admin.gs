function setupSheets(){
  const lock=LockService.getScriptLock();lock.waitLock(10000);
  try{
    const props=PropertiesService.getScriptProperties();let id=props.getProperty('SPREADSHEET_ID');const book=id?SpreadsheetApp.openById(id):SpreadsheetApp.create('ARAIA — NC Retention Enfagrow');
    if(!id){id=book.getId();props.setProperty('SPREADSHEET_ID',id);}if(!props.getProperty('AUTH_PEPPER'))props.setProperty('AUTH_PEPPER',Utilities.getUuid()+Utilities.getUuid());
    Object.keys(RetentionCore.SCHEMA).forEach(name=>{let sheet=book.getSheetByName(name);if(!sheet)sheet=book.insertSheet(name);const headers=RetentionCore.SCHEMA[name];if(sheet.getMaxColumns()<headers.length)sheet.insertColumnsAfter(sheet.getMaxColumns(),headers.length-sheet.getMaxColumns());sheet.getRange(1,1,1,headers.length).setValues([headers]).setBackground('#0A0A0B').setFontColor('#FFFFFF').setFontWeight('bold');sheet.setFrozenRows(1);sheet.getRange(2,1,sheet.getMaxRows()-1,headers.length).setNumberFormat('@');});
    const enums={Risk_Snapshot:{status:['Low','Moderate','High']},Signals:Object.fromEntries(RetentionCore.CATEGORIES.map(k=>[k,['0','1','2','3']])),Users:{role:['Admin','HR','Supervisor','Viewer']},NC:{status_kerja:['Aktif','Resign'],onboarding_status:RetentionCore.STAGES},Training:{hasil:['Lulus','Ulang']},Requests:{tipe:['izin','cuti'],status:['Diajukan','Menunggu HR','Disetujui','Ditolak']},ActionPlans:{status:['Aktif','Selesai'],hasil_akhir:['Pulih','Tetap','Resign']},CheckIns:{status:['On track','Perlu penyesuaian','Eskalasi']},Onboarding_CheckIns:{status:['On track','Perlu penyesuaian','Eskalasi']},Conversations:{akar_masalah:RetentionCore.ROOTS},Attrition_Log:{alasan:RetentionCore.ROOTS}};
    Object.keys(enums).forEach(table=>Object.keys(enums[table]).forEach(col=>{const index=RetentionCore.SCHEMA[table].indexOf(col)+1;book.getSheetByName(table).getRange(2,index,book.getSheetByName(table).getMaxRows()-1,1).setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(enums[table][col],true).setAllowInvalid(false).build());}));
    const booleanColumns={Users:['aktif'],Conversations:['sensitif'],ActionItems:['selesai'],Onboarding_Checklist:['selesai'],Attrition_Log:['pernah_high_risk','pernah_action_plan']};Object.keys(booleanColumns).forEach(t=>booleanColumns[t].forEach(h=>book.getSheetByName(t).getRange(2,RetentionCore.SCHEMA[t].indexOf(h)+1,book.getSheetByName(t).getMaxRows()-1,1).setDataValidation(SpreadsheetApp.newDataValidation().requireCheckbox().build())));
    const store=store_();if(!store.read('Config').length)Object.keys(RetentionCore.DEFAULTS).forEach(key=>store.upsert('Config',{key,value:JSON.stringify(RetentionCore.DEFAULTS[key])}));
    if(!store.read('Users').length){const pass=props.getProperty('INITIAL_ADMIN_PASSWORD');if(!pass||pass.length<8||pass.length>200)throw new Error('Sheet sudah dibuat. Isi INITIAL_ADMIN_PASSWORD minimal 8 karakter di Script properties lalu jalankan setupSheets kembali.');const username=(props.getProperty('INITIAL_ADMIN_USERNAME')||'admin').trim().toLowerCase();if(!/^[a-z0-9._-]{3,60}$/.test(username))throw new Error('INITIAL_ADMIN_USERNAME harus 3–60 huruf kecil/angka/titik/garis bawah.');const salt=Utilities.getUuid();store.append('Users',[{user_id:'ADM01',username,nama:'Admin Araia',role:'Admin',area:'Nasional',supervisor_id:'',salt,pin_hash:passwordHash_(pass,salt),aktif:true,last_login:''}]);}
    invalidate_(store.commit());props.deleteProperty('INITIAL_ADMIN_PASSWORD');console.log('Setup selesai: https://docs.google.com/spreadsheets/d/'+id+'/edit');return{spreadsheetId:id};
  }finally{lock.releaseLock();}
}
function seedDemoData(){
  const lock=LockService.getScriptLock();lock.waitLock(10000);
  try{const props=PropertiesService.getScriptProperties(),store=store_();if(store.read('NC').length)throw new Error('Seed dibatalkan: sheet NC sudah berisi data.');const demoPassword=props.getProperty('DEMO_USER_PASSWORD');if(!demoPassword||demoPassword.length<8||demoPassword.length>200)throw new Error('Isi DEMO_USER_PASSWORD di Script properties (minimal 8 karakter).');const db=RetentionSeed.create();
    db.Users.filter(u=>u.user_id!=='ADM01').forEach(u=>{if(store.read('Users').some(x=>x.username===u.username))return;const salt=Utilities.getUuid();store.append('Users',[{...u,salt,pin_hash:passwordHash_(demoPassword,salt),supervisor_id:'',last_login:''}]);});
    Object.keys(db).filter(t=>!['Users','Config'].includes(t)).forEach(t=>{if(db[t].length)store.append(t,db[t]);});invalidate_(store.commit());props.setProperty('DEMO_NC_IDS',JSON.stringify(db.NC.map(n=>n.nc_id)));props.setProperty('DEMO_USER_IDS',JSON.stringify(db.Users.filter(u=>u.user_id!=='ADM01').map(u=>u.user_id)));props.deleteProperty('DEMO_USER_PASSWORD');console.log('40 NC contoh dibuat. Akun contoh memakai password yang Anda tentukan.');
  }finally{lock.releaseLock();}
}
function removeDemoData(){
  const props=PropertiesService.getScriptProperties();if(props.getProperty('CONFIRM_REMOVE_DEMO')!=='REMOVE_DEMO')throw new Error('Untuk menghapus data contoh, isi CONFIRM_REMOVE_DEMO=REMOVE_DEMO di Script properties.');const ids=new Set(JSON.parse(props.getProperty('DEMO_NC_IDS')||'[]')),userids=new Set(JSON.parse(props.getProperty('DEMO_USER_IDS')||'[]'));if(!ids.size)return;
  const lock=LockService.getScriptLock();lock.waitLock(10000);
  try{const store=store_();if(store.read('NC').some(n=>!ids.has(n.nc_id)&&userids.has(n.supervisor_id)))throw new Error('Ada NC non-demo memakai supervisor demo. Pindahkan ke supervisor produksi sebelum menghapus demo.');const plans=new Set(store.read('ActionPlans').filter(p=>ids.has(p.nc_id)).map(p=>p.plan_id)),book=SpreadsheetApp.openById(props.getProperty('SPREADSHEET_ID'));
    Object.keys(RetentionCore.SCHEMA).filter(t=>!['Config','Audit_Log'].includes(t)).forEach(t=>{const rows=store.read(t),kept=rows.filter(r=>!ids.has(r.nc_id)&&!plans.has(r.plan_id)&&!(t==='Users'&&userids.has(r.user_id)));if(kept.length===rows.length)return;const sheet=book.getSheetByName(t),headers=RetentionCore.SCHEMA[t];sheet.getRange(2,1,Math.max(1,rows.length),headers.length).clearContent();if(kept.length)sheet.getRange(2,1,kept.length,headers.length).setValues(kept.map(r=>headers.map(h=>r[h]??'')));});invalidate_(Object.keys(RetentionCore.SCHEMA));props.deleteProperty('DEMO_NC_IDS');props.deleteProperty('DEMO_USER_IDS');props.deleteProperty('CONFIRM_REMOVE_DEMO');console.log('Data contoh dan riwayat terkait dihapus. Data NC lainnya tetap tersimpan.');
  }finally{lock.releaseLock();}
}
function dailyRefresh(){const lock=LockService.getScriptLock();if(!lock.tryLock(5000))return;try{const store=store_(),user=store.read('Users').find(u=>u.role==='Admin'&&RetentionCore.TRUE(u.aktif));if(!user)return;const engine=RetentionCore.createEngine(store,user,{uuid:()=>Utilities.getUuid()});engine.roster().forEach(n=>engine.refreshSnapshot(n.nc_id));invalidate_(store.commit());['dashboard','reminders'].forEach(a=>cacheWrite_(cacheKey_(a,{},user),engine.read(a,{}),600));}finally{lock.releaseLock();}}
function installTriggers(){removeTriggers();ScriptApp.newTrigger('dailyRefresh').timeBased().everyDays(1).atHour(7).inTimezone('Asia/Jakarta').create();console.log('Trigger harian aktif sekitar pukul 07.00 WIB.');}
function removeTriggers(){ScriptApp.getProjectTriggers().filter(t=>t.getHandlerFunction()==='dailyRefresh').forEach(t=>ScriptApp.deleteTrigger(t));}
